{
    "name": "fidechat",
    "version": "1.0.0",
    "private": true,
    "description": "Fidechat monorepo — Discord clone (NestJS + Next.js + Oracle + Keycloak)",
    "license": "MIT",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "test:e2e": "turbo run test:e2e",
        "format": "oxfmt",
        "clean": "turbo run clean && rm -rf node_modules .turbo",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "oxlint-tsgolint": "^7.0.2001",
        "turbo": "^2.10.11",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@11.22.0"
}
