{
    "name": "fidechat",
    "version": "1.0.0",
    "private": true,
    "description": "Fidechat monorepo: Discord clone (NestJS + Next.js + PostgreSQL + Keycloak)",
    "license": "MIT",
    "scripts": {
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "test:e2e": "turbo run test:e2e",
        "format": "oxfmt",
        "clean": "turbo run clean && rm -rf node_modules .turbo",
        "format:check": "oxfmt --check",
        "typecheck": "turbo run typecheck",
        "check": "turbo run lint typecheck && oxfmt --check"
    },
    "devDependencies": {
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "turbo": "^2.11.10",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=26.13.0",
        "pnpm": ">=12.0.0"
    },
    "packageManager": "pnpm@12.16.1"
}
