{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2024",
        "lib": ["es2024"],
        "types": [],
        "strict": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "skipLibCheck": true
    },
    "include": ["src"]
}
