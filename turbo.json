{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "envMode": "loose",
    "globalDependencies": [".env", "**/.env.*local"],
    "futureFlags": {
        "watchUsingTaskInputs": true
    },
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "@fidechat/api#dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true,
            "interruptible": true,
            "inputs": ["package.json"]
        },
        "start": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"]
        },
        "test:e2e": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "clean": {
            "cache": false
        },
        "format": {
            "cache": false
        },
        "format:check": {
            "outputs": []
        }
    }
}
