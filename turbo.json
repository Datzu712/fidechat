{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "envMode": "loose",
    "globalDependencies": [".env", "**/.env.*local"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"]
        },
        "test:e2e": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "clean": {
            "cache": false
        }
    }
}
