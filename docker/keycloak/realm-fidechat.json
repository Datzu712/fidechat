{
    "realm": "fidechat",
    "enabled": true,
    "registrationAllowed": true,
    "loginWithEmailAllowed": true,
    "clients": [
        {
            "clientId": "fidechat",
            "name": "Fidechat",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": false,
            "clientAuthenticatorType": "client-secret",
            "secret": "demo-v3-client-secret",
            "standardFlowEnabled": true,
            "directAccessGrantsEnabled": true,
            "redirectUris": ["http://localhost:4300/*"],
            "webOrigins": ["http://localhost:4300"],
            "attributes": {
                "post.logout.redirect.uris": "http://localhost:4300/*"
            },
            "protocolMappers": [
                {
                    "name": "fidechat-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "urn:fidechat:api",
                        "access.token.claim": "true",
                        "introspection.token.claim": "true",
                        "id.token.claim": "false"
                    }
                }
            ]
        }
    ],
    "users": [
        {
            "id": "11111111-1111-1111-1111-111111111111",
            "username": "ana",
            "email": "ana@demo.local",
            "emailVerified": true,
            "firstName": "Ana",
            "lastName": "Rojas",
            "enabled": true,
            "credentials": [{ "type": "password", "value": "demo1234", "temporary": false }]
        },
        {
            "id": "22222222-2222-2222-2222-222222222222",
            "username": "bruno",
            "email": "bruno@demo.local",
            "emailVerified": true,
            "firstName": "Bruno",
            "lastName": "Mora",
            "enabled": true,
            "credentials": [{ "type": "password", "value": "demo1234", "temporary": false }]
        }
    ]
}
