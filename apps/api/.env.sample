# App config
NODE_ENV=development
API_PORT=8080
# Built web SPA to serve from this API (set in the production image; leave empty in dev)
WEB_DIST_DIR=
# Behind a reverse proxy or load balancer: comma-separated IPs/CIDRs of the proxies trusted to set
# X-Forwarded-For (e.g. 10.0.0.0/8). Leave empty when clients connect directly.
TRUST_PROXY=

# Guild al que se agrega automaticamente a cada usuario nuevo (UUID)
DEFAULT_GUILD_ID=

# Base de datos de la aplicacion (Postgres + Drizzle).
# Corre en la misma instancia que usa Keycloak, pero en su propia base `fidechat`.
DATABASE_URL=postgres://admin:root@localhost:5432/fidechat
DATABASE_POOL_MAX=10

# Postgres (contenedor compartido: base `keycloak` + base de la app)
PG_USER=admin
PG_PASSWORD=root
PG_NAME=keycloak
APP_DB_NAME=fidechat

# Keycloak config
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_URL=http://localhost:8081
PUBLIC_KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=fidechat
KEYCLOAK_CLIENT_ID=fidechat
KEYCLOAK_CLIENT_SECRET=

# BFF login: the API runs the Keycloak login and gives the browser a session cookie.
# Register AUTH_CALLBACK_URL as a valid redirect URI and PUBLIC_WEB_URL as a valid
# post logout redirect URI in the Keycloak client. In dev the Vite server on 3000 proxies
# /api and /socket.io to this API, so the callback goes through the web origin.
AUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/callback
PUBLIC_WEB_URL=http://localhost:3000/

# chat yipiti
OPENAI_API_KEY=
