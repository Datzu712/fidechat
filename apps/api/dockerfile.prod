# Docker production build file (monorepo-aware)
# El contexto de build es la RAIZ del monorepo, no apps/api:
#   docker build -f apps/api/dockerfile.prod .

FROM node:22-alpine AS base
RUN npm install -g pnpm@11.22.0
WORKDIR /repo

# ---- dependencias (dev + prod) para compilar ----
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile --filter @fidechat/api...

# ---- build ----
FROM deps AS builder
COPY turbo.json ./
COPY apps/api ./apps/api
RUN pnpm --filter @fidechat/api build

# ---- dependencias solo de produccion ----
FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile --prod --filter @fidechat/api...

# ---- runner ----
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Install Oracle Instant Client
# RUN apk --no-cache add libaio libc6-compat curl unzip && \
#     curl -o instantclient.zip https://download.oracle.com/otn_software/linux/instantclient/instantclient-basiclite-linuxx64.zip -SL && \
#     unzip instantclient.zip && \
#     rm instantclient.zip && \
#     mv instantclient*/ /instantclient && \
#     ln -s /instantclient/libclntsh.so.19.1 /instantclient/libclntsh.so && \
#     ln -s /instantclient/libocci.so.19.1 /instantclient/libocci.so && \
#     apk add --no-cache bash

ENV LD_LIBRARY_PATH=/instantclient

# node_modules de pnpm: la raiz guarda el store (.pnpm) y apps/api solo enlaces
# relativos hacia el, por lo que hay que copiar ambos para conservarlos.
COPY --from=prod-deps /repo/node_modules ./node_modules
COPY --from=prod-deps /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /repo/apps/api/dist ./apps/api/dist
COPY --from=builder /repo/apps/api/package.json ./apps/api/package.json

# Copy SQL scripts needed for application
# COPY apps/api/sql ./apps/api/sql

# Create a non-root user to run the application
# RUN addgroup -g 1001 -S nodejs && \
#     adduser -S nodejs -u 1001 -G nodejs

# Switch to non-root user
#USER nodejs

WORKDIR /app/apps/api

# Start the application
CMD ["node", "dist/main.js"]

# HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD ./healthcheck.sh todo
