# Docker production build file (monorepo-aware)
# El contexto de build es la RAIZ del monorepo, no apps/api:
#   docker build -f apps/api/dockerfile.prod .

FROM node:26-alpine AS base
RUN npm install -g pnpm@12.16.1
WORKDIR /repo

# ---- dependencias (dev + prod) para compilar ----
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile --filter @fidechat/api...

# ---- build ----
FROM deps AS builder
COPY turbo.json ./
COPY apps/api ./apps/api
RUN pnpm --filter @fidechat/api build

# ---- web SPA: the API serves it, so the browser and the BFF cookie share one origin ----
FROM base AS web-builder
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
RUN pnpm install --frozen-lockfile --filter @fidechat/web...
COPY apps/web ./apps/web
RUN pnpm --filter @fidechat/web build

# ---- dependencias solo de produccion ----
FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile --prod --filter @fidechat/api...

# ---- runner ----
FROM node:26-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# node_modules de pnpm: la raiz guarda el store (.pnpm) y apps/api solo enlaces
# relativos hacia el, por lo que hay que copiar ambos para conservarlos.
COPY --from=prod-deps /repo/node_modules ./node_modules
COPY --from=prod-deps /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /repo/apps/api/dist ./apps/api/dist
COPY --from=builder /repo/apps/api/package.json ./apps/api/package.json
COPY --from=web-builder /repo/apps/web/dist ./apps/web/dist
ENV WEB_DIST_DIR=/app/apps/web/dist

# Copy SQL scripts needed for application
# COPY apps/api/sql ./apps/api/sql

# Create a non-root user to run the application
# RUN addgroup -g 1001 -S nodejs && \
#     adduser -S nodejs -u 1001 -G nodejs

# Switch to non-root user
#USER nodejs

WORKDIR /app/apps/api

# Start the application
CMD ["node", "dist/main.js"]

# HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD ./healthcheck.sh todo
