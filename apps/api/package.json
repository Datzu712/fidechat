{
    "name": "@fidechat/api",
    "version": "1.0.0",
    "private": true,
    "description": "Fidechat backend API (NestJS + Fastify + Postgres/Drizzle + Keycloak)",
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "format": "oxfmt",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "oxlint --type-aware",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --inspect-brk --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
        "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "lint:fix": "oxlint --type-aware --fix",
        "format:check": "oxfmt --check",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@fastify/compress": "^9.2.0",
        "@fastify/csrf-protection": "^8.0.1",
        "@fastify/helmet": "^13.1.1",
        "@fastify/static": "^10.1.5",
        "@nestjs/common": "^12.1.1",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.1.1",
        "@nestjs/platform-fastify": "^12.1.1",
        "@nestjs/platform-socket.io": "^12.1.1",
        "@nestjs/swagger": "^12.0.2",
        "@nestjs/websockets": "^12.1.1",
        "@sentry/nestjs": "^11.1.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dayjs": "^1.11.23",
        "dotenv": "^18.0.4",
        "drizzle-orm": "^0.45.3",
        "fastify": "5.12.5",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.1.0",
        "keycloak-connect": "^26.1.1",
        "nest-keycloak-connect": "^1.10.1",
        "openai": "^7.23.0",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.4",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@nestjs/cli": "^12.0.8",
        "@nestjs/schematics": "^12.0.6",
        "@nestjs/testing": "^12.1.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.2",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.19.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "drizzle-kit": "^0.31.11",
        "jest": "^30.5.2",
        "socket.io-client": "^4.8.4",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.0",
        "ts-essentials": "^10.2.1",
        "ts-jest": "^29.4.14",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=24.15.0"
    }
}
